# Public address of the live site (no trailing slash). Used for canonical links, share previews,
# robots.txt and sitemap.xml. Change it here if the site moves to another domain.
VITE_SITE_URL=https://mrktkings.com

# Where Let's Connect bookings are sent: a form backend that accepts JSON POSTs, e.g. a Formspree
# form URL. Leave unset and the form opens the visitor's email app instead.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
