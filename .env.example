# Copy this file to .env and fill in the values. .env is never committed (see .gitignore).
# When a host builds the site (Vercel, Netlify, Cloudflare Pages and so on), set them in its environment
# variables settings instead. There the names can drop VITE_: SITE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY.

# Public address of the live site (no trailing slash). Used for canonical links, share previews,
# robots.txt and sitemap.xml. Required: the build stops without it.
VITE_SITE_URL=https://mrktkings.com

# Supabase stores Let's Connect bookings and powers the /admin/ page (set up with supabase/schema.sql).
# The key is the project's publishable key (sb_publishable_...) or legacy anon key, from Project Settings ->
# API Keys. It is safe in the browser. Never put the secret or service_role key here.
# Leave the key empty and the form opens the visitor's email app instead.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
